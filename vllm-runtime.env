# Canonical companion vLLM runtime configuration.
# Keep this runtime isolated from ai-research-env-gpu so vLLM can use the
# PyTorch/CUDA stack its published wheels are built against.
VLLM_VERSION=0.28.0
VLLM_PYTHON=3.12
UV_VERSION=0.12.6

# EFabric's stock GPU workspaces expose a CUDA-capable driver/runtime but do not
# currently provide nvcc. FlashInfer's top-k/top-p sampler may JIT-compile CUDA
# extensions and therefore fails on those workspaces. Keep vLLM's optimized
# attention backends, but default sampling to the PyTorch-native implementation.
export VLLM_USE_FLASHINFER_SAMPLER="${VLLM_USE_FLASHINFER_SAMPLER:-0}"

# Disable anonymous usage telemetry in the project research runtime. This also
# avoids writes under ~/.config/vllm on EFabric, where ~/.config may not be a
# normal writable directory.
export VLLM_NO_USAGE_STATS="${VLLM_NO_USAGE_STATS:-1}"
